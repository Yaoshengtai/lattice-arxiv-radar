# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/
.coverage
htmlcov/

# next.js
/.next/
/.next-dev/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.tsbuildinfo
__pycache__/
*.py[cod]
.cache/
.tmp/
tmp/
temp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
.venv/
venv/
env/

# vercel
.vercel

/dist/
/build/
/.wrangler/
/outputs/
/work/

# local data, uploads, and databases
/uploads/
/storage/
/data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# all durable research data stays on this computer
/research-data/*
!/research-data/inbox/
!/research-data/reports/
!/research-data/uploads/
/research-data/inbox/*
!/research-data/inbox/.gitkeep
/research-data/reports/*
!/research-data/reports/.gitkeep
/research-data/uploads/*
!/research-data/uploads/.gitkeep
/research-data/tmp/
/research-data/downloads/

# separate Next.js output for the public Pages app
/public-site/.next/
/public-site/out/
