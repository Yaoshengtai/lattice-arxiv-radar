{
  "name": "lattice-arxiv-radar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm build && next start --hostname 127.0.0.1 --port 4310",
    "build": "next build",
    "build:pages": "next build public-site",
    "export:public": "node scripts/export-public-dashboard.mjs",
    "publish:dashboard": "node scripts/publish-dashboard.mjs",
    "start": "next start --hostname 127.0.0.1 --port 4310",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "lucide-react": "^1.29.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
